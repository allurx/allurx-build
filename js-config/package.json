{
    "name": "@allurx/js-config",
    "version": "1.0.0",
    "description": "Shared ESLint, Prettier, TypeScript and Vite configuration.",
    "license": "Apache-2.0",
    "type": "module",
    "repository": {
        "type": "git",
        "url": "git+https://github.com/allurx/allurx-build.git",
        "directory": "js-config"
    },
    "publishConfig": {
        "access": "public"
    },
    "engines": {
        "node": ">=24"
    },
    "exports": {
        "./eslint": {
            "types": "./dist/eslint.d.ts",
            "default": "./dist/eslint.js"
        },
        "./prettier": {
            "types": "./dist/prettier.d.ts",
            "default": "./dist/prettier.js"
        },
        "./vite": {
            "types": "./dist/vite.d.ts",
            "default": "./dist/vite.js"
        },
        "./tsconfig/base": "./tsconfig/tsconfig.base.json",
        "./tsconfig/browser": "./tsconfig/tsconfig.browser.json",
        "./tsconfig/node": "./tsconfig/tsconfig.node.json"
    },
    "files": [
        "dist/",
        "tsconfig/",
        "LICENSE.txt"
    ],
    "scripts": {
        "build": "npm run clean && tsc --project tsconfig.build.json",
        "check": "npm run format:check && npm run lint && npm run type-check",
        "lint": "eslint . --max-warnings 0",
        "format:check": "prettier . --config configs/prettier.ts --check",
        "test": "node --test tests/consumer.test.ts",
        "verify": "npm run build && npm run check && npm test",
        "prepack": "npm run build",
        "type-check": "tsc --noEmit",
        "format": "prettier . --config configs/prettier.ts --write",
        "clean": "node scripts/clean.ts"
    },
    "dependencies": {
        "@eslint/js": "10.0.1",
        "globals": "17.13.0",
        "typescript-eslint": "8.71.2"
    },
    "peerDependencies": {
        "eslint": "^10.12.0",
        "prettier": "^3.9.10",
        "typescript": ">=6.0.3 <6.1.0",
        "vite": "^8.3.4"
    },
    "peerDependenciesMeta": {
        "prettier": {
            "optional": true
        },
        "vite": {
            "optional": true
        }
    },
    "devDependencies": {
        "@types/node": "24.19.2",
        "eslint": "10.12.0",
        "prettier": "3.9.10",
        "typescript": "6.0.3",
        "vite": "8.3.4",
        "jiti": "2.7.0"
    }
}
